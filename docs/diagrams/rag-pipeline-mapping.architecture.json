  "cards": [
    {
      "dot": "cyan",
      "title": "官方骨架",
      "items": [
        "DefaultRetrievalAugmentor 负责编排，KbRetriever.augmentor() 装配四个槽位",
        "CorpusEmbeddingStore 落在官方 EmbeddingStore<TextSegment> 这一格，A 路只把向量检索交给它",
        "LlmRouterChatModel 实现官方 ChatModel，包住 opencode-go → deepseek"
      ]
    },
    {
      "dot": "emerald",
      "title": "槽位全自研",
      "items": [
        "QueryTransformer / ContentRetriever / ContentAggregator / ContentInjector 四格实现都写在 kb 包",
        "问题向量一次检索只算一次，在 KbContextFactory.build() 里算，A 路与 C 路共用",
        "KbContentInjector + TwoSectionInjector 保住 <<<KNOWLEDGE>>> 两段出处契约"
      ]
    },
    {
      "dot": "amber",
      "title": "聚合器内固定顺序",
      "items": [
        "RRF 融合 → TitleVectorGate 标题闸门置顶 → CrossEncoderReranker 重排 → 地点意图提权 → 截断 top-5",
        "重排候选 20 条、min-score 0.02、模型 BAAI/bge-reranker-v2-m3",
        "C 路不是第三路召回，标题向量闸门跑在聚合器内部"
      ]
    }
  ]
