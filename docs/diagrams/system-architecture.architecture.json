  "cards": [
    {
      "dot": "rose",
      "title": "一问一答，回路是闭合的",
      "items": [
        "去程：QQ 群友 → NapCat → 事件接入与路由（POST /onebot/event）",
        "判定：黑名单 → 指令 → Guard 五层 → 成本预算，全部跑完才轮到模型",
        "模型侧：ChatService → 提问 + 资料块 → 大模型服务 → 回答文本",
        "回路：ChatService → 回答文本 → 事件接入与路由 → send_group_msg → NapCat → 回复到群"
      ]
    },
    {
      "dot": "cyan",
      "title": "四条结构铁律（ArchUnit 守着）",
      "items": [
        "onebot/ 是唯一出现协议细节的包，OneBotApiClient 是唯一发消息出口",
        "llm/ 是唯一知道用哪个模型的地方，业务包不得碰模型 SDK",
        "guard/ 是唯一有权说不的地方，且不得依赖 kb / qa / llm",
        "持久化层之外不得出现 java.sql，kb 不得依赖 qa / admin / settings"
      ]
    },
    {
      "dot": "emerald",
      "title": "入口与记录",
      "items": [
        "三个入口：/onebot/** 上报、/api/public/** 公开站、/admin/api/** 后台",
        "问答记录异步投递，绝不占用回答线程；队列有界，满了丢弃并计数",
        "库写坏了只记日志，机器人照常回答；同人 60 秒内再问自动标 follow_up"
      ]
    }
  ]
