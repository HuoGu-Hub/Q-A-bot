  "cards": [
    {
      "dot": "cyan",
      "title": "四条结构铁律",
      "items": [
        "onebot/ 是唯一出现协议细节的包",
        "OneBotApiClient 是全工程唯一发消息出口",
        "llm/ 是唯一知道用哪个模型的地方",
        "guard/ 是唯一有权说「不」的地方"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "NapCat 端口只绑回环，绝不暴露公网",
        "Nginx 是公网唯一入口，后台另有 IP 白名单",
        "公开接口用独立 DTO，不复用管理接口返回值"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态与数据",
      "items": [
        "所有人工成果落在一个 SQLite 文件，备份一条命令",
        "知识库块与统计共用一个连接，避免 WAL 冲突",
        "标题向量是 C 路闸门，不参与 RRF 投票"
      ]
    }
  ]
