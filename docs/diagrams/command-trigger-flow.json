    {
      "id": "usage",
      "lane": "fail",
      "col": 2,
      "type": "security",
      "label": "用法提示",
      "sublabel": "缺参 · 类型不符"
    }
  ],
  "edges": [
    {
      "id": "user-gate",
      "from": "user",
      "to": "gate",
      "variant": "default"
    },
    {
      "id": "gate-parser",
      "from": "gate",
      "to": "parser",
      "label": "命中",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelAt": [
        300,
        305
      ]
    },
    {
      "id": "parser-dispatcher",
      "from": "parser",
      "to": "dispatcher",
      "label": "参数就绪",
      "variant": "default",
      "labelAt": [
        365,
        429
      ]
    },
    {
      "id": "parser-usage",
      "from": "parser",
      "to": "usage",
      "label": "不合格",
      "variant": "security",
      "role": "error",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "dispatcher-action",
      "from": "dispatcher",
      "to": "action",
      "label": "kind=action",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelAt": [
        476,
        553
      ]
    },
    {
      "id": "action-timer",
      "from": "action",
      "to": "timer",
      "label": "写入待发",
      "variant": "default",
      "labelAt": [
        500,
        470
      ]
    },
    {
      "id": "timer-sent",
      "from": "timer",
      "to": "sent",
      "label": "到点发送",
      "variant": "emphasis",
      "role": "return",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "触发形态",
      "items": [
        "斜杠形态保留：/命令 值 值",
        "破折号形态新增：@机器人 命令-值-值",
        "命令名不在指令表里就当普通聊天",
        "群里是否必须 @，仍由开关决定"
      ]
    },
    {
      "dot": "emerald",
      "title": "切分与类型",
      "items": [
        "类型化参数从右往左锚定",
        "文本参数吃剩下的全部",
        "值里本身带 - 时用引号包住",
        "时间接受 20:00 / 明天20:00 / 10-18 20:00"
      ]
    },
    {
      "dot": "rose",
      "title": "到点与撤销",
      "items": [
        "创建时回一个编号，编号就是任务 id",
        "创建者本人或群管才能删除",
        "超过宽限期的任务标记过期，不补发",
        "发送走同一个出站口，过滤与节流不绕过"
      ]
    }
  ]
}