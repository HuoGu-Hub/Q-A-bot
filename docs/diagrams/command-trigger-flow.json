  "lanes": [
    {
      "id": "client",
      "label": "QQ 群聊"
    },
    {
      "id": "entry",
      "label": "入口判定"
    },
    {
      "id": "args",
      "label": "参数解析"
    },
    {
      "id": "dispatch",
      "label": "指令分派"
    },
    {
      "id": "exec",
      "label": "动作执行"
    },
    {
      "id": "timeline",
      "label": "定时投递"
    },
    {
      "id": "fail",
      "label": "未命中与提示",
      "variant": "exception"
    }
