  "cards": [
    {
      "dot": "cyan",
      "title": "命令写法",
      "items": [
        "一律以 / 开头，@ 只是入群闸门",
        "路径可以分层：/set /output",
        "路径按最长匹配吃词，吃不动就停",
        "群里是否必须 @ 读准入设置"
      ]
    },
    {
      "dot": "emerald",
      "title": "参数写法",
      "items": [
        "#变量名-值#，顺序随意",
        "变量名中英皆可，新增指令时定义",
        "值里的 - 与空格原样保留",
        "名字不在参数表里就回用法提示"
      ]
    },
    {
      "dot": "rose",
      "title": "帮助与定时",
      "items": [
        "/路径 /help 输出这一条命令的帮助",
        "帮助文档由参数表自动生成，也可手写",
        "例：/set /output #time-21:30# 文本",
        "创建者本人或群管才能撤销"
      ]
    }
  ]
