      "label": "识别与解析",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "execute",
      "label": "执行与落库",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "user",
    "gate",
    "parser",
    "dispatcher",
    "action",
    "timer",
    "sent"
  ],
  "nodes": [
    {
      "id": "user",
      "lane": "client",
      "col": 0,
      "type": "external",
      "label": "群友",
      "sublabel": "@机器人 记录-打本-20:00"
    },
    {
      "id": "gate",
      "lane": "entry",
      "col": 1,
      "type": "backend",
      "label": "入口判定",
      "sublabel": "准入 · @ · 双形态",
      "tag": "MessageRouter"
    },
    {
      "id": "parser",
      "lane": "args",
      "col": 2,
      "type": "backend",
      "label": "参数解析",
      "sublabel": "右锚定 · 类型归一",
      "tag": "ArgParser"
    },
    {
      "id": "dispatcher",
      "lane": "dispatch",
      "col": 3,
      "type": "backend",
      "label": "指令分派",
      "sublabel": "话术 · 问答 · 动作",
      "tag": "CommandHandler"
    },
    {
      "id": "action",
      "lane": "exec",
      "col": 3,
      "type": "messagebus",
      "label": "动作执行",
      "sublabel": "创建 · 删除 · 列表",
      "tag": "ActionRegistry"
    },
    {
      "id": "timer",
      "lane": "timeline",
      "col": 5,
      "type": "backend",
      "label": "定时投递",
      "sublabel": "读任务表 · 到点出站",
      "tag": "ScheduleRunner"
