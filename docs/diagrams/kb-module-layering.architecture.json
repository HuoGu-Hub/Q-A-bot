  "cards": [
    {
      "dot": "cyan",
      "title": "为什么是两个真源",
      "items": [
        "改名字零成本：单行 UPDATE，不碰语料与向量",
        "改内容必须成对更新向量：只改一边会静默用错资料",
        "变化原因不同，所以是两块，不是一个模型的两个字段"
      ]
    },
    {
      "dot": "emerald",
      "title": "环为什么不在了",
      "items": [
        "唯一同时拥有两半的是组合层",
        "导入登记由组合层编排，块层不再调名字层",
        "依赖方向只剩自上而下一条规则"
      ]
    },
    {
      "dot": "rose",
      "title": "共享身份 EntryId",
      "items": [
        "块 id 与词条 en 是同一个身份，由类型看住",
        "创建点只有两处：导入落库、词条行读库",
        "字符串只在三层边界：SQL / HTTP / 模型元数据"
      ]
    }
  ]
