# 复制成 .env 后填入真实值。.env 已被 .gitignore 排除，不会提交。
#
# ⚠️ 这是 properties 格式，不是 shell 脚本：
#    · 一行一个 KEY=value
#    · 值不要加引号

# ---------- NapCat 容器（设备指纹固定）----------
# 机器人 QQ 号：让 NapCat 重启后自动快速登录，不用扫码。
# ⚠️ 变量名是 NAPCAT_QUICK_ACCOUNT（不是 NAPCAT_QQ，后者源码里不存在）
# 更推荐：不改这里，去 WebUI「配置 → 登录配置 → 快速登录 QQ」设置，不用重建容器
NAPCAT_QUICK_ACCOUNT=
# 固定的 MAC 地址（冒号分隔）。先用下面这条命令查出当前值再填：
#   docker exec napcat cat /sys/class/net/eth0/address
# ⚠️ 必须填当前正在用的值！随便填会立刻掉登录
NAPCAT_MAC=
# 容器用户 UID/GID（Linux/WSL 上用 id -u / id -g 的结果；Windows 用 0）
NAPCAT_UID=0
NAPCAT_GID=0

# ---------- 协议层（NapCat）----------
# NapCat 的 HTTP 接口地址
ONEBOT_API_BASE=http://127.0.0.1:3000
# 必须和 NapCat「网络配置 → HTTP服务器 → Token」完全一致
ONEBOT_TOKEN=

# ---------- 大模型（填一个就能跑）----------
# OpenCode Go：https://opencode.ai/  （注意模型要走 chat/completions 那种）
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=
# DeepSeek 官方
DEEPSEEK_API_KEY=
# 通义千问（M4 图片理解会用）
DASHSCOPE_API_KEY=

# ---------- 管理后台 ----------
# ⚠️ 留空 = 整个 /admin 返回 503（安全默认，绝不裸奔）。
# 后台能看到群里的提问原文，所以必须设一个你自己知道的密码。
#
# ⚠️ 位置有讲究：.env 要放在【工程根目录】（和 AGENTS.md 同级）。
#    后端的运行目录是 server/，早期版本只按相对路径找 ./.env，于是这里
#    明明填了密码，后台仍然报「未设置 ADMIN_PASSWORD」。现在改成从运行
#    目录向上找工程根，启动时会打印一行 [CONFIG] 说明读了哪个文件。
# ⚠️ 改完必须【重启后端】才生效（密码是后端校验的，重启前端没用）。
ADMIN_PASSWORD=

# ---------- 机器人身份 / 群信息（可选，通常不用填）----------
# ✅ 优先在**管理后台**里改，全部热生效（不用重启、也不用碰 .env、不用改 yml）：
#    · 设置 → 机器人身份          机器人昵称 + 运营方 / 技术支持署名
#                                （昵称用于 {bot} 变量与限流话术；运营方/署名展示在公开站「关于」页）
#    · 页面文案 → 页脚 · 版权行     页脚那行署名文字
#    · 设置 → 站点信息            公开站「关于」页的群名 / 群号
# 后台改动会写进 server/config/overrides.yml（不进版本控制）并持久化。
#
# 下面只用于**首次部署、还没有后台**时打底（Spring 宽松绑定：app.bot.name → APP_BOT_NAME）。
# 别把真实身份改回 application.yml —— 仓库是公开的。
#APP_BOT_NAME=机器人的昵称，不是你的名字
# 运营方 / 技术支持署名（公开站「关于」页展示；留空则不显示那一行）
#APP_BOT_ORG=
#APP_BOT_AUTHOR=
#
# ⚠️ 机器人「在哪些群工作」不在这里配：**任何群都会响应**，
#    只有「设置 → 回复行为 → 群黑名单」能排除若干群，那同样是热生效、可随时增删。
#    下面两项只是公开站「关于」页要展示的那个群（单值、展示用）。
#APP_SITE_GROUP_NAME=
#APP_SITE_GROUP_NUMBER=

# ---------- 开发用：允许的穿透 / 代理域名（可选）----------
# 前端 dev server（pnpm dev）的 allowedHosts。用隧道或域名访问 localhost:5173 时才需要；
# 生产构建产物由后端 8080 托管，用不到这一项。
# 逗号分隔，前导点 =「该域名本身 + 任意子域」（隧道给的子域名会变，用点前缀省事）。
# vite.config.ts 读这个键；后端进程也会看到它，但没有任何代码使用，无害。
#ALLOWED_HOSTS=.example.com,.example.org

# ---------- 数据目录（可选：想把数据挪出 server/data 时才填）----------
# 下面几项默认都是**相对进程工作目录**的路径（./data/...）。同一个 jar，换个目录起就是另一套数据：
#     cd /opt/qqbot        && java -jar server/target/…jar   →  /opt/qqbot/data/…
#     cd /opt/qqbot/server && java -jar target/…jar          →  /opt/qqbot/server/data/…
# 搞错的后果**不是报错**，而是它在别处现建一套空的 —— 看起来就像数据全丢了。
# 启动日志里搜「[路径]」能看到每一项解析后的绝对路径，核对一下最省事。
#
# ⚠️ 这几行**故意是注释掉的**（和上面那些密钥不一样）：空值和"不写"含义完全相反，
#    写成 APP_QA_DB= 会让程序把数据目录解析成空路径 —— 比不写更糟。
# ⚠️ 变量名里的短横线要去掉：app.media.kb-images.dir → APP_MEDIA_KBIMAGES_DIR。
# ⚠️ systemd 部署时，换到 ReadWritePaths 之外的目录要同步加一行，否则 ProtectSystem=strict 会让它写不进去。
#
# 要用就取消注释并填**绝对路径**：
#APP_QA_DB=/opt/qqbot/data/qqbot.sqlite
#APP_KB_DIR=/opt/qqbot/data/kb
#APP_SITE_CAROUSEL_DIR=/opt/qqbot/data/site-images
#APP_MEDIA_KBIMAGES_DIR=/opt/qqbot/data/kb-images
#APP_MEDIA_TEMPIMAGES_DIR=/opt/qqbot/data/tmp-images
#LOG_FILE=/opt/qqbot/data/logs/qqbot.log

# ---------- 知识库检索（RAG）用的向量模型 ----------
# 默认硅基流动 BAAI/bge-m3（OpenAI 兼容接口）。
# ⚠️ 建索引和查询【必须用同一个模型】，中途换模型必须整库重建。
# 换阿里云百炼：填 DASHSCOPE_API_KEY，并把 application.yml 里
#   app.kb.embedding.base-url 改成 https://dashscope.aliyuncs.com/compatible-mode/v1
#   app.kb.embedding.model    改成 qwen3.7-text-embedding
SILICONFLOW_API_KEY=
