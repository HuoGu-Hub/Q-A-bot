{
  "name": "qqbot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Q-A-bot 前端 —— 公开站 + 管理后台（双端）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/shared/api/schema.d.ts",
    "predev": "pnpm gen:api",
    "prebuild": "pnpm gen:api",
    "pretypecheck": "pnpm gen:api"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
